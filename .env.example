# ---------------------------------------------------------------
# CéramiquePro — variables d'environnement
# Copier ce fichier vers .env.local puis renseigner les valeurs.
# .env.local n'est jamais versionné.
# ---------------------------------------------------------------

# --- Base de données (MongoDB Atlas recommandé : les transactions
#     nécessitent un replica set, fourni par Atlas, même en offre gratuite)
MONGODB_URI="mongodb+srv://<utilisateur>:<mot-de-passe>@<cluster>.mongodb.net/?retryWrites=true&w=majority"
MONGODB_DB="ceramique-pro"

# --- Images (Cloudinary) — intégré mais pas encore utilisé :
#     le jeu de données d'exemple utilise des images locales.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
CLOUDINARY_FOLDER="ceramique-pro"

# --- Serveur (Next.js + Socket.io)
PORT=3000

# --- Sessions (RBAC) : clé de signature des cookies de session, 32 caractères minimum.
#     Obligatoire en production. Générer avec :
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=""

# --- Mot de passe provisoire des comptes créés par « npm run users:init » (non versionné)
USERS_DEFAULT_PASSWORD=""

# --- Mode démo (maquette uniquement) : boutons de connexion rapide, sans mot de passe,
#     aux comptes admin@cpro.com, depot1@cpro.com et depot2@cpro.com.
#     ⚠️ Quiconque a le lien devient administrateur : ne jamais activer avec de vraies données.
DEMO_LOGIN="false"

# --- Sauvegardes : clé de chiffrement (32 caractères minimum). La même valeur en local et sur Vercel,
#     sinon les sauvegardes de production ne pourront pas être restaurées depuis votre ordinateur.
#     node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BACKUP_KEY=""
